<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        SpringBoot 版本锁定 3.2.5（不要用 3.2.x 浮动写法，防止拉取到不兼容版本）
        依赖版本统一由 parent 管理，pom 中不手动指定版本号，避免版本冲突
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>springboot-kafka-demo</artifactId>
    <version>1.0.0</version>
    <name>springboot-kafka-demo</name>
    <description>SpringBoot 3.2.5 + JDK21 + Kafka 入门学习 Demo</description>

    <properties>
        <!-- JDK 21 源码 & 目标编译版本 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web starter：提供 REST 接口手动发消息验证 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Kafka 官方 starter，坐标为中央仓库稳定版本
            版本由 parent 统一管理：spring-kafka 3.1.4 + kafka-clients 3.6.x，与 SpringBoot 3.2.5 完全配套
            注意：SpringBoot3 全家桶均为 jakarta.* 包，本依赖无 javax/jakarta 冲突，无需 exclusion
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- 测试依赖（可选，方便后续写单元测试） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- SpringBoot 打包插件：mvn package 生成可执行 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        仓库说明：不配置私服，默认走 Maven 中央仓库，任何人 clone 后都能直接下载依赖。
        国内网络拉取慢可在 ~/.m2/settings.xml 配置阿里云镜像（见 README 常见问题）。
    -->
</project>
